# 曙島 Dawn Isle — 環境變數範本
# 複製成 .env.local 再填入真實值。不要把 .env 或 .env.local 提交進 git。
# 正式環境到 Vercel 專案 threejs3dgame → Settings → Environment Variables 設定。
# NEXT_PUBLIC_ 會在建置時寫進瀏覽器，改完必須重新部署。

# [本地與 Production 必填 | 僅伺服器 server-only | Preview 請留空]
# 應用程式對外網址，用來組 Google 回呼。本地：http://localhost:3000
# Production：https://threejs3dgame.vercel.app
# Vercel Preview 不要設，Better Auth 會依該次請求的網址推斷。
BETTER_AUTH_URL=http://localhost:3000

# [登入必填 | 僅伺服器 server-only]
# 簽署 session 的密鑰，至少 32 字元。產生：openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# [登入必填 | 僅伺服器 server-only]
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# [登入必填 | 僅伺服器 server-only]
# Supabase → Project Settings → Database → Connection string → Transaction pooler（port 6543）
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# [選填，跑 migration 時建議要有 | 僅伺服器 server-only]
# Supabase → Database → Connection string → Direct connection 或 Session pooler（port 5432）
# 沒填時，npm run db:migrate 會改用 DATABASE_URL。
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# [即時同步選填 | 會暴露給瀏覽器 exposed to the browser]
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co

# [即時同步選填，兩支鑰匙擇一 | 會暴露給瀏覽器 exposed to the browser]
# 優先用 publishable key（sb_publishable_...）。這不是密鑰，但仍不要提交真實值。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# [選填，舊版 anon public key 的別名 | 會暴露給瀏覽器 exposed to the browser]
# 儀表板若還沒有 publishable key，把 anon public key 填在這裡，上一行可留空。
NEXT_PUBLIC_SUPABASE_ANON_KEY=
